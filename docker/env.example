# Ordo.sh Environment Configuration
# Copy this file to .env and fill in your values
#
# cp env.example .env
# vim .env

# =============================================================================
# VNC SETTINGS
# =============================================================================

# Password for desktop access (default: ordo)
VNC_PASSWORD=ordo

# Desktop resolution (default: 1920x1080)
VNC_RESOLUTION=1920x1080

# Color depth (default: 24)
VNC_COL_DEPTH=24

# =============================================================================
# OPENCLAW CONFIGURATION
# =============================================================================

# Auto-configure OpenClaw on startup (default: true)
ORDO_AUTO_CONFIG=true

# =============================================================================
# AI PROVIDER KEYS (at least one required for OpenClaw)
# =============================================================================

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# MESSAGING CHANNELS
# =============================================================================

# Telegram Bot
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Discord Bot
# Get from Discord Developer Portal
DISCORD_TOKEN=

# Slack Bot
SLACK_TOKEN=

# WhatsApp (via WhatsApp Business API)
WHATSAPP_TOKEN=

# =============================================================================
# PLATFORM TOKENS (for autonomous deployment)
# =============================================================================

# GitHub Personal Access Token
# Scopes: repo, workflow, read:org
GITHUB_TOKEN=

# Vercel
VERCEL_TOKEN=

# Netlify
NETLIFY_AUTH_TOKEN=

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Railway
RAILWAY_TOKEN=

# Firebase
FIREBASE_TOKEN=

# =============================================================================
# WEB SEARCH
# =============================================================================

# Brave Search API
BRAVE_API_KEY=

# =============================================================================
# GIT CONFIGURATION
# =============================================================================

GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# =============================================================================
# EMAIL (optional)
# =============================================================================

EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
