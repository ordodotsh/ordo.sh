{
  "name": "ordo",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\" \"bun run dev:convex\"",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:client": "vite",
    "dev:convex": "npx convex dev",
    "build": "vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/static": "^1.2.0",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@vercel/analytics": "^1.6.1",
    "convex": "^1.21.0",
    "elysia": "^1.4.18",
    "lottie-react": "^2.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.13.0",
    "semver": "^7.7.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
